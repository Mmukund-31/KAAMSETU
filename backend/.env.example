# ──────────────────────────────────────────────────────────────────────────
# KAAMSETU backend environment template.
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# ──────────────────────────────────────────────────────────────────────────

# ── Gnani AI (generate a key at https://app.gnani.ai/voice) ──────────────
GNANI_API_KEY=
# Both Prisma (STT) and Timbre (TTS) are served from one host; paths are code constants.
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_PRISMA_MODEL=prisma-v3.0
# indic-auto = automatic Indic language detection (Prisma v3.0). Overridden per request by the user's language choice.
GNANI_PRISMA_DEFAULT_LANGUAGE=indic-auto
GNANI_TIMBRE_MODEL=timbre-v2.5
# Timbre v2.5 voices are bound to a language. See docs/GNANI_INTEGRATION.md for the full list.
GNANI_TIMBRE_VOICE_HI=Nalini
GNANI_TIMBRE_VOICE_EN=Kaveri
GNANI_TIMBRE_VOICE_TE=Suhana
GNANI_TIMBRE_VOICE_HINGLISH=Poorvi
GNANI_TIMEOUT_SECONDS=30
GNANI_MAX_RETRIES=3

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+pg8000://kaamsetu:kaamsetu@localhost:5433/kaamsetu
# Used by docker-compose for the postgres container
POSTGRES_USER=kaamsetu
POSTGRES_PASSWORD=kaamsetu
POSTGRES_DB=kaamsetu
# Optional separate DB for pytest (defaults to DATABASE_URL + "_test" if unset)
DATABASE_URL_TEST=

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
MAX_AUDIO_UPLOAD_MB=10
# Prisma REST accepts clips up to 30 seconds
MAX_AUDIO_SECONDS=30
# Audio retention policy: none | hours:24 | days:7
AUDIO_RETENTION=none
# Allow a technician to approve their own work order (policy switch, default off)
ALLOW_SELF_APPROVAL=false
