# Backend URL the app calls. Inlined at build time (EXPO_PUBLIC_*).
# Phone on the same Wi-Fi as the dev machine: use the machine's LAN IP and start the backend with --host 0.0.0.0
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:8001
# Android emulator: http://10.0.2.2:8001   Web / iOS simulator: http://localhost:8001
EXPO_PUBLIC_API_URL=
