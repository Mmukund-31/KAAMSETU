{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "KAAMSETU_ALLOW_HTTP": "1",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.20:8001"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://kaamsetu.example.com" }
    }
  }
}
